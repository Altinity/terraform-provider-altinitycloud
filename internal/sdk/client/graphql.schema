  """Resource usage quotas users can be assigned to."""
  quotas: [ClickHouseQuotaSpecInput!]
  """Partial quotas update."""
  quotasPatch: ClickHouseQuotaSpecsPatchInput
  """Server configuration settings."""
  serverSettings: [AWSEnvClickHouseServerSettingSpecInput!]
