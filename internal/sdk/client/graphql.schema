  """
  Explicit list of AWS availability zones ids (https://docs.aws.amazon.com/global-infrastructure/latest/regions/az-ids.html).
  At least 2 required.

  Example: ["usw2-az1", "usw2-az2"]

  This field is optional if "numberOfZones" is specified.
  """
  zoneIDs: [String!]
