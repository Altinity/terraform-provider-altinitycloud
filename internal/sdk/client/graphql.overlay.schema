Iceberg configuration.
"""
type HostedAWSEnvIcebergSpec {
  """
  List of Iceberg catalogs.
  """
  catalogs: [HostedAWSEnvIcebergCatalogSpec!]!
}

"""
Iceberg catalog type.
"""
enum HostedAWSEnvIcebergCatalogTypeSpec {
  """
  S3 bucket-based catalog.
  """
  S3
  """
  S3 Tables-based catalog.
  """
  S3_TABLE
}

"""
Iceberg catalog configuration.
"""
type HostedAWSEnvIcebergCatalogSpec {
  """
  Catalog name.
  Empty name represents the default catalog.
  """
  name: String
  """
  Catalog type.
  """
  type: HostedAWSEnvIcebergCatalogTypeSpec!
  """
  Custom S3 bucket name.
  """
  customS3Bucket: String
  """
  Path within the custom S3 bucket.
  """
  customS3BucketPath: String
  """
  ARN of the S3 Tables bucket.
  """
  customS3TableBucketARN: String
  """
  AWS region for the catalog.
  """
  region: String
  """
  Whether anonymous access is enabled.
  """
  anonymousAccessEnabled: Boolean
  """
  Maintenance configuration.
  """
  maintenance: HostedAWSEnvIcebergCatalogMaintenanceSpec!
  """
  Table watch configurations.
  """
  watches: [HostedAWSEnvIcebergCatalogWatchSpec!]!
}

"""
Iceberg catalog maintenance configuration.
"""
type HostedAWSEnvIcebergCatalogMaintenanceSpec {
  """
  Whether maintenance is enabled.
  """
  enabled: Boolean!
}

"""
Iceberg catalog watch configuration.
"""
type HostedAWSEnvIcebergCatalogWatchSpec {
  """
  Table name to watch.
  """
  table: String!
  """
  Paths relative to table location to watch.
  """
  pathsRelativeToTableLocation: [String!]!
}

