AWS environment custom S3 bucket configuration input.
"""
input AWSEnvHostedBackupsCustomBucketSpecInput {
  """
  S3 bucket name.
  """
  name: String!
  """
  S3 bucket region.
  """
  region: String!
  """
  IAM role to assume for bucket access.
  """
  roleARN: String!
}

"""
AWS environment create request result.
"""
type CreateAWSEnvHostedResult {
  """
  Mutation unique identifier.
  """
  mutationId: ID!
  """
  AWS environment active configuration.
  """
  spec: AWSEnvHostedSpec!
  """
  Spec revision (monotonically-increasing).
  """
  specRevision: Int!
}
extend type Mutation {
  """
  Marks Altinity-hosted AWS environment for removal (if exists; noop otherwise).

  This triggers env deprovisioning which deletes all the data (except for backups),
  as well as all provisioned AWS resources.
  """
  deleteAWSEnvHosted(input: DeleteAWSEnvHostedInput!): DeleteAWSEnvHostedResult!
}

"""
AWS environment delete request input.
"""
input DeleteAWSEnvHostedInput {
  """
  The name of AWS environment to delete.
  """
  name: String!
  """
  By default, delete mutation does not delete the env but rather marks it to be
  removed once it's deprovisioned (which may take some time).
  Set "force" to true to skip deprovisioning.
  """
  force: Boolean = false
  """
  By default, the delete operation will not delete any provisioned clusters and
  the deletion will fail until the clusters get removed.
  Set "forceDestroyClusters" to true remove all provisioned clusters as part of the environment deletion process.
  """
  forceDestroyClusters: Boolean = false
}

"""
AWS environment delete request result.
"""
type DeleteAWSEnvHostedResult {
  """
  Mutation unique identifier.
  """
  mutationId: ID!
  pendingMFA: Boolean!
}
"""
Iceberg configuration.
"""
type AWSEnvHostedIcebergSpec {
  """
  List of Iceberg catalogs.
  """
  catalogs: [AWSEnvHostedIcebergCatalogSpec!]!
}

"""
Iceberg catalog type.
"""
enum AWSEnvHostedIcebergCatalogTypeSpec {
  """
  S3 bucket-based catalog.
  """
  S3
  """
  S3 Tables-based catalog.
  """
  S3_TABLE
}

"""
Iceberg catalog configuration.
"""
type AWSEnvHostedIcebergCatalogSpec {
  """
  Catalog name.
  Empty name represents the default catalog.
  """
  name: String
  """
  Catalog type.
  """
  type: AWSEnvHostedIcebergCatalogTypeSpec!
  """
  Custom S3 bucket name.
  """
  customS3Bucket: String
  """
  Path within the custom S3 bucket.
  """
  customS3BucketPath: String
  """
  ARN of the S3 Tables bucket.
  """
  customS3TableBucketARN: String
  """
  AWS region for the catalog.
  """
  region: String
  """
  Whether anonymous access is enabled.
  """
  anonymousAccessEnabled: Boolean
  """
  Maintenance configuration.
  """
  maintenance: AWSEnvHostedIcebergCatalogMaintenanceSpec!
  """
  Table watch configurations.
  """
  watches: [AWSEnvHostedIcebergCatalogWatchSpec!]!
}

"""
Iceberg catalog maintenance configuration.
"""
type AWSEnvHostedIcebergCatalogMaintenanceSpec {
  """
  Whether maintenance is enabled.
  """
  enabled: Boolean!
}

"""
Iceberg catalog watch configuration.
"""
type AWSEnvHostedIcebergCatalogWatchSpec {
  """
  Table name to watch.
  """
  table: String!
  """
  Paths relative to table location to watch.
  """
  pathsRelativeToTableLocation: [String!]!
}

