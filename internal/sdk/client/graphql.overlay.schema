"""
Iceberg configuration update input.
"""
input HostedAWSEnvIcebergUpdateInputSpec {
  """
  List of Iceberg catalogs to create or update.
  """
  catalogs: [HostedAWSEnvIcebergCatalogInputSpec!]
  """
  List of catalog names to delete.
  """
  catalogsToDelete: [String!]
}
extend type Mutation {
  """
  Update Altinity-hosted AWS environment record.
  """
  updateHostedAWSEnv(input: UpdateHostedAWSEnvInput!): UpdateHostedAWSEnvResult!
}

