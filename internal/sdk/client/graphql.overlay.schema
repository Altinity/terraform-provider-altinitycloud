  watches: [AWSEnvHostedIcebergCatalogWatchInputSpec!]
}

"""
Iceberg catalog maintenance configuration input.
"""
input AWSEnvHostedIcebergCatalogMaintenanceInputSpec {
  """
  Whether maintenance is enabled.
  """
  enabled: Boolean!
}

"""
Iceberg catalog watch configuration input.
"""
input AWSEnvHostedIcebergCatalogWatchInputSpec {
  """
  Table name to watch.
  """
  table: String!
  """
  Paths relative to table location to watch.
